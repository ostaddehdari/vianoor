{
  "openapi": "3.1.0",
  "info": {
    "title": "Vianoor foundation API",
    "version": "0.1.0",
    "description": "Implemented foundation only. Business API inventory is in api-inventory.json."
  },
  "servers": [
    {
      "url": "http://localhost:4100"
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "liveness",
        "responses": {
          "200": {
            "description": "Process alive; not business readiness",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "readiness",
        "responses": {
          "503": {
            "description": "Stage 1 scaffold is intentionally not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1": {
      "get": {
        "operationId": "foundationInfo",
        "responses": {
          "200": {
            "description": "Foundation metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta",
                    "trace_id"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "service",
                        "stage"
                      ],
                      "properties": {
                        "service": {
                          "type": "string"
                        },
                        "stage": {
                          "const": "scaffold"
                        }
                      }
                    },
                    "meta": {
                      "type": "object"
                    },
                    "trace_id": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{32}$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": [
          "status",
          "service",
          "stage"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "live",
              "not_ready"
            ]
          },
          "service": {
            "type": "string"
          },
          "stage": {
            "const": "scaffold"
          }
        }
      }
    }
  }
}
